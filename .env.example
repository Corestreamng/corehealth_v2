# ==============================================================================
# COREHEALTH V2 ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED LOCAL APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="CoreHealth HMIS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 2. REQUIRED DATABASE CONFIGURATION (MySQL 8.0 / MariaDB)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=_corehealth_db_v2_test
DB_USERNAME=root
DB_PASSWORD=password

# ------------------------------------------------------------------------------
# 3. SERVICE CATEGORY MAPPINGS
# ------------------------------------------------------------------------------
BED_SERVICE_CATGORY_ID=3
INVESTGATION_CATEGORY_ID=2
CONSULTATION_CATEGORY_ID=1
NUSRING_SERVICE_CATEGORY=4
MISC_SERVICE_CATEGORY_ID=5
IMAGING_CATEGORY_ID=6
REGISTRATION_CATEGORY_ID=7

# ------------------------------------------------------------------------------
# 4. CACHE & QUEUE DRIVERS
# ------------------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 5. OPTIONAL THIRD-PARTY INTEGRATIONS (Set as needed for production)
# ------------------------------------------------------------------------------
# Mail Integration
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@corehealth.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 Storage (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher Realtime WebSockets (Optional)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Google Maps API Key (Optional)
GOOGLE_MAPS_API_KEY=
