{
    "private": true,
    "scripts": {
        "dev": "npm run development",
        "development": "mix",
        "watch": "mix watch",
        "watch-poll": "mix watch -- --watch-options-poll=1000",
        "hot": "mix watch --hot",
        "prod": "npm run production",
        "production": "mix --production",
        "check:js": "find public/js -maxdepth 1 -name '*.js' -exec node --check {} +",
        "capture:screenshots": "node tools/capture_workbench_screenshots.js",
        "docs:dev": "mkdir -p docs/public/js && cp node_modules/mermaid/dist/mermaid.min.js docs/public/js/mermaid.min.js && vitepress dev docs",
        "docs:build": "mkdir -p docs/public/js && cp node_modules/mermaid/dist/mermaid.min.js docs/public/js/mermaid.min.js && vitepress build docs",
        "docs:preview": "vitepress preview docs"
    },
    "devDependencies": {
        "@popperjs/core": "^2.10.2",
        "axios": "^0.21",
        "bootstrap": "^5.3.8",
        "laravel-mix": "^6.0.6",
        "lodash": "^4.18.1",
        "mermaid": "^12.3.0",
        "postcss": "^8.5.28",
        "puppeteer-core": "^25.16.0",
        "resolve-url-loader": "^5.0.0",
        "sass": "^1.105.1",
        "sass-loader": "^17.0.1",
        "vitepress": "^1.6.4"
    },
    "dependencies": {
        "@selectize/selectize": "^0.15.2",
        "jquery": "^4.0.0",
        "select2": "^4.1.0"
    }
}
