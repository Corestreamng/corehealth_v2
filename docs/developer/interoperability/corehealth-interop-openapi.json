{
  "openapi": "3.0.3",
  "info": {
    "title": "Corehealth by CorestreamNG \u2014 Interoperability & AI Scribe API",
    "description": "Enterprise API for Multi-Standard Healthcare Interoperability (HL7 FHIR R4, openEHR ITS-REST, OpenEMR Compatibility, NDPA 2023 Statutory Privacy) and the CoreHealth AI Scribe Embeddable SDK.",
    "version": "2.6.0",
    "contact": {
      "name": "Corehealth by CorestreamNG",
      "email": "hello@corestream.ng",
      "url": "https://corestream.ng"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "Local Edge Node / Development Server"
    },
    {
      "url": "https://corehealth.corestream.ng",
      "description": "CoreHealth Public Cloud Gateway"
    }
  ],
  "components": {
    "securitySchemes": {
      "SanctumBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Laravel Sanctum Personal Access Token (PAT) for server-to-server or authenticated sessions."
      },
      "SdkSessionToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Short-lived ephemeral SDK session token (SKT_...) minted via /api/sdk/auth/token."
      },
      "BasicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "SHA-256 encrypted Basic Auth for automated system sync pipelines."
      }
    },
    "schemas": {
      "OperationOutcome": {
        "type": "object",
        "properties": {
          "resourceType": {
            "type": "string",
            "example": "OperationOutcome"
          },
          "issue": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "type": "string",
                  "example": "error"
                },
                "code": {
                  "type": "string",
                  "example": "security"
                },
                "diagnostics": {
                  "type": "string"
                }
              }
            }
          },
          "message": {
            "type": "string"
          }
        }
      },
      "SdkTokenRequest": {
        "type": "object",
        "required": [
          "client_id",
          "client_secret"
        ],
        "properties": {
          "client_id": {
            "type": "string",
            "example": "partner-emr-dev"
          },
          "client_secret": {
            "type": "string",
            "example": "sec_dev_sample_secret_key"
          },
          "patient_id": {
            "type": "integer",
            "example": 492
          },
          "encounter_id": {
            "type": "integer",
            "example": 1017
          },
          "clinician_id": {
            "type": "integer",
            "example": 38
          },
          "scope": {
            "type": "string",
            "example": "scribe:process scribe:sign interop:compositions"
          },
          "ttl": {
            "type": "integer",
            "example": 3600
          }
        }
      },
      "SdkTokenResponse": {
        "type": "object",
        "properties": {
          "sdk_token": {
            "type": "string",
            "example": "SKT_eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..."
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "example": 3600
          },
          "scope": {
            "type": "string",
            "example": "scribe:process scribe:sign interop:compositions"
          },
          "patient_id": {
            "type": "integer",
            "example": 492
          },
          "encounter_id": {
            "type": "integer",
            "example": 1017
          },
          "clinician_id": {
            "type": "integer",
            "example": 38
          },
          "ndpa_consent_status": {
            "type": "string",
            "example": "ACTIVE"
          }
        }
      },
      "CompositionsHandoffResponse": {
        "type": "object",
        "properties": {
          "session_token_jti": {
            "type": "string"
          },
          "patient_id": {
            "type": "integer",
            "example": 492
          },
          "encounter_id": {
            "type": "integer",
            "example": 1017
          },
          "signed_at": {
            "type": "string",
            "format": "date-time"
          },
          "final_signed_note": {
            "type": "string"
          },
          "openehr_composition": {
            "type": "object",
            "description": "Standard openEHR COMPOSITION.encounter.v1 JSON structure"
          },
          "fhir_bundle": {
            "type": "object",
            "description": "Standard HL7 FHIR R4 Transaction Bundle JSON"
          }
        }
      },
      "ClinicalOrderItem": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "medication",
              "laboratory",
              "imaging",
              "procedure",
              "nursing",
              "consultation"
            ],
            "example": "medication"
          },
          "name": {
            "type": "string",
            "example": "Paracetamol 500mg Tab"
          },
          "matched_id": {
            "type": [
              "integer",
              "string",
              "null"
            ],
            "example": 101
          },
          "matched_tariff": {
            "type": [
              "number",
              "null"
            ],
            "example": 500.0
          },
          "dosage": {
            "type": [
              "string",
              "null"
            ],
            "example": "1g"
          },
          "frequency": {
            "type": [
              "string",
              "null"
            ],
            "example": "TDS (Three times daily)"
          },
          "duration": {
            "type": [
              "string",
              "null"
            ],
            "example": "3 days"
          },
          "route": {
            "type": [
              "string",
              "null"
            ],
            "example": "Oral"
          },
          "indication": {
            "type": [
              "string",
              "null"
            ],
            "example": "Headache / Mild Pyrexia"
          },
          "instructions": {
            "type": [
              "string",
              "null"
            ],
            "example": "Take after meals with water"
          }
        }
      },
      "CatalogCategory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "code": {
            "type": "string",
            "example": "LAB_HEMATOLOGY"
          },
          "name": {
            "type": "string",
            "example": "Hematology & Blood Transfusion"
          },
          "type": {
            "type": "string",
            "example": "service"
          }
        }
      },
      "CatalogItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 204
          },
          "name": {
            "type": "string",
            "example": "Full Blood Count (FBC)"
          },
          "type": {
            "type": "string",
            "example": "laboratory"
          },
          "category_id": {
            "type": [
              "integer",
              "null"
            ],
            "example": 1
          },
          "category_name": {
            "type": [
              "string",
              "null"
            ],
            "example": "Hematology"
          },
          "code": {
            "type": [
              "string",
              "null"
            ],
            "example": "LAB-FBC-01"
          },
          "price": {
            "type": [
              "number",
              "null"
            ],
            "example": 4500.0
          },
          "stock_count": {
            "type": [
              "integer",
              "null"
            ],
            "example": null
          },
          "cscp": {
            "type": "string",
            "example": "#CAT:204|laboratory|Full Blood Count (FBC)"
          }
        }
      },
      "ConvertFormatRequest": {
        "type": "object",
        "required": [
          "note",
          "source_taxonomy",
          "target_taxonomy"
        ],
        "properties": {
          "note": {
            "type": "string",
            "example": "SUBJECTIVE:\nPatient presents with 3-day history of dry cough and intermittent pyrexia.\n\nOBJECTIVE:\nBP: 120/80 mmHg, PR: 78 bpm, Temp: 38.2 C.\n\nASSESSMENT:\nAcute Upper Respiratory Tract Infection (URTI).\n\nPLAN:\n1. Paracetamol 1g TDS x 3 days\n2. Malaria Rapid Diagnostic Test (mRDT)"
          },
          "source_taxonomy": {
            "type": "string",
            "example": "soap"
          },
          "target_taxonomy": {
            "type": "string",
            "example": "traditional"
          },
          "source_role": {
            "type": "string",
            "example": "doctor"
          },
          "target_role": {
            "type": "string",
            "example": "doctor"
          }
        }
      },
      "ConvertFormatResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "source_taxonomy": {
            "type": "string",
            "example": "soap"
          },
          "target_taxonomy": {
            "type": "string",
            "example": "traditional"
          },
          "source_role": {
            "type": "string",
            "example": "doctor"
          },
          "target_role": {
            "type": "string",
            "example": "doctor"
          },
          "converted_note": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/api/sdk/auth/token": {
      "post": {
        "summary": "Issue Ephemeral SDK Session Token",
        "description": "Partner backend exchanges client credentials for a signed short-lived SKT_ token scoped to an encounter/patient.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SdkTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token successfully minted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SdkTokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid client credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationOutcome"
                }
              }
            }
          }
        }
      }
    },
    "/api/sdk/auth/revoke": {
      "post": {
        "summary": "Revoke SDK Session Token",
        "description": "Invalidate an active SDK token immediately.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token revocation status"
          }
        }
      }
    },
    "/api/sdk/scribe/session": {
      "post": {
        "summary": "Initialize AI Scribe Session",
        "security": [
          {
            "SdkSessionToken": []
          }
        ],
        "responses": {
          "201": {
            "description": "Session context established"
          },
          "401": {
            "description": "Unauthenticated"
          }
        }
      }
    },
    "/api/sdk/scribe/process": {
      "post": {
        "summary": "Process Audio Dictation / Transcript with Grounded Catalog & Suggested Orders",
        "description": "Process consultation transcript or audio dictation. Accepts partner custom catalogs in super-compressed CSCP format (#CAT:id|type|name or gzipped base64), performs clinical grounding, detects active patient allergies, and extracts structured orders (medications, labs, imaging, procedures, nursing, consultation).",
        "security": [
          {
            "SdkSessionToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "transcript": {
                    "type": "string",
                    "example": "Patient presents with acute headache and high grade pyrexia. BP 125/82, Temp 38.5C. Assessment is severe malaria. Prescribe Artemether-Lumefantrine 80/480mg twice daily for 3 days and request Malaria Parasite by Microscopy."
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "doctor",
                      "nurse",
                      "maternity"
                    ],
                    "default": "doctor"
                  },
                  "taxonomy": {
                    "type": "string",
                    "enum": [
                      "soap",
                      "traditional",
                      "pomr",
                      "dar",
                      "sbar",
                      "soapie",
                      "anc",
                      "labor",
                      "pnc"
                    ],
                    "default": "soap"
                  },
                  "language": {
                    "type": "string",
                    "example": "en-NG"
                  },
                  "custom_catalog": {
                    "description": "Super-compressed CSCP (#CAT:id|type|name) DSL string, base64-gzipped CSCP, or JSON array of partner items.",
                    "oneOf": [
                      {
                        "type": "string",
                        "example": "#CAT:101|medication|Artemether-Lumefantrine 80/480mg\n#CAT:201|laboratory|Malaria Parasite (MP) Giemsa"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      }
                    ]
                  },
                  "patient_id": {
                    "type": "integer",
                    "example": 492
                  },
                  "encounter_id": {
                    "type": "integer",
                    "example": 1017
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured clinical sections, detected allergy alerts, and categorized suggested orders deck",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "sections": {
                      "type": "object"
                    },
                    "formatted_note": {
                      "type": "string"
                    },
                    "orders": {
                      "type": "array",
                      "items": {
                        "": "#/components/schemas/ClinicalOrderItem"
                      }
                    },
                    "allergy_alerts": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "taxonomy": {
                      "type": "string",
                      "example": "soap"
                    },
                    "role": {
                      "type": "string",
                      "example": "doctor"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sdk/scribe/sign": {
      "post": {
        "summary": "Sign Consultation Note, Archive Audit Record & Seal Approved Orders",
        "description": "Seal the consultation note with clinician sign-off. Commits the signed clinical note and approved orders deck (with inline dosage/frequency/instructions adjustments) into the audit trail for downstream openEHR and FHIR generation.",
        "security": [
          {
            "SdkSessionToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "final_signed_note"
                ],
                "properties": {
                  "final_signed_note": {
                    "type": "string"
                  },
                  "original_transcript": {
                    "type": "string"
                  },
                  "approved_orders": {
                    "type": "array",
                    "items": {
                      "": "#/components/schemas/ClinicalOrderItem"
                    }
                  },
                  "patient_id": {
                    "type": "integer",
                    "example": 492
                  },
                  "encounter_id": {
                    "type": "integer",
                    "example": 1017
                  },
                  "clinician_id": {
                    "type": "integer",
                    "example": 38
                  },
                  "role": {
                    "type": "string",
                    "example": "doctor"
                  },
                  "taxonomy": {
                    "type": "string",
                    "example": "soap"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Note successfully signed, audited, and approved orders staged for dispatch",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "signed"
                    },
                    "audit_id": {
                      "type": "integer",
                      "example": 812
                    },
                    "orders_dispatched": {
                      "type": "integer",
                      "example": 2
                    },
                    "message": {
                      "type": "string",
                      "example": "Consultation signed, audited, and 2 orders staged for dispatch."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sdk/scribe/session/{token}/compositions": {
      "post": {
        "summary": "Fetch openEHR Composition & HL7 FHIR R4 Bundle Handoff",
        "security": [
          {
            "SdkSessionToken": []
          }
        ],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cross_border": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Standardized clinical data payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompositionsHandoffResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/fhir/r4/metadata": {
      "get": {
        "summary": "FHIR R4 CapabilityStatement (Public)",
        "responses": {
          "200": {
            "description": "Conformance statement"
          }
        }
      }
    },
    "/api/fhir/r4/Patient": {
      "get": {
        "summary": "Search Patients",
        "security": [
          {
            "SanctumBearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Bundle of Patient resources"
          }
        }
      },
      "post": {
        "summary": "Create Patient (Proxies PatientController@store)",
        "security": [
          {
            "SanctumBearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Created Patient"
          }
        }
      }
    },
    "/api/fhir/r4/Observation": {
      "get": {
        "summary": "Search Observations",
        "security": [
          {
            "SanctumBearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "Record Vital Signs (Proxies VitalSignController@store)",
        "security": [
          {
            "SanctumBearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Created Observation"
          }
        }
      }
    },
    "/api/fhir/r4/MedicationRequest": {
      "post": {
        "summary": "Prescribe Medication via WHO ATC (Proxies EncounterController@addSinglePrescriptionRequest)",
        "security": [
          {
            "SanctumBearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Created MedicationRequest"
          }
        }
      }
    },
    "/api/openehr/v1/ehr": {
      "post": {
        "summary": "Create EHR for Subject",
        "security": [
          {
            "SanctumBearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Created EHR with ehr_id"
          }
        }
      }
    },
    "/api/openehr/v1/query/aql": {
      "post": {
        "summary": "Execute Archetype Query Language (AQL) Query",
        "security": [
          {
            "SanctumBearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "AQL Query Result Set"
          }
        }
      }
    },
    "/api/ndpa/v1/consent": {
      "post": {
        "summary": "Record Statutory NDPA 2023 Consent",
        "security": [
          {
            "SanctumBearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Consent record created"
          }
        }
      }
    },
    "/api/sdk/scribe/convert-format": {
      "post": {
        "summary": "Lossless Medical Taxonomy Conversion",
        "description": "Deterministically convert consultation notes between medical taxonomies (Doctor: SOAP, Traditional Clerking, POMR; Nurse: Focus DAR, SBAR, SOAPIE; Maternity: ANC, Labor, PNC) while preserving all clinical observations and findings.",
        "security": [
          {
            "SdkSessionToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "": "#/components/schemas/ConvertFormatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transformed consultation note",
            "content": {
              "application/json": {
                "schema": {
                  "": "#/components/schemas/ConvertFormatResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sdk/scribe/compositions": {
      "post": {
        "summary": "Direct openEHR & FHIR Compositions Extraction",
        "description": "Directly retrieve openEHR COMPOSITION.encounter.v1 and HL7 FHIR R4 Bundle for the authenticated session, including all approved clinical orders mapped to openEHR INSTRUCTION archetypes.",
        "security": [
          {
            "SdkSessionToken": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "encounter_id": {
                    "type": "integer"
                  },
                  "cross_border": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Standardized clinical data payload",
            "content": {
              "application/json": {
                "schema": {
                  "": "#/components/schemas/CompositionsHandoffResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sdk/scribe/fhir-bundle": {
      "post": {
        "summary": "Direct HL7 FHIR R4 Encounter Bundle Extraction",
        "description": "Directly extract the full HL7 FHIR R4 Bundle containing Patient, Encounter, Observations, Condition, MedicationRequest, and ServiceRequest resources.",
        "security": [
          {
            "SdkSessionToken": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "encounter_id": {
                    "type": "integer"
                  },
                  "cross_border": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Standard HL7 FHIR R4 Bundle"
          }
        }
      }
    },
    "/api/sdk/catalogs/categories": {
      "get": {
        "summary": "List Active Catalog Categories",
        "description": "Fetch hospital product and clinical service categories (Laboratory, Imaging, Pharmacy, Nursing, Procedures, Consultation) for catalog synchronization.",
        "security": [
          {
            "SdkSessionToken": []
          },
          {
            "SanctumBearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "service",
                "product"
              ],
              "default": "all"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of catalog categories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "count": {
                      "type": "integer",
                      "example": 6
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "": "#/components/schemas/CatalogCategory"
                      }
                    }
                  }
