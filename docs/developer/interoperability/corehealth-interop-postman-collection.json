            "name": "00. Authentication",
            "item": [
                {
                    "name": "POST Acquire Sanctum PAT",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "const tokenText = pm.response.text();",
                                    "if (tokenText) {",
                                    "    try {",
                                    "        const json = JSON.parse(tokenText);",
                                    "        if (json.token) pm.environment.set(\"token\", json.token);",
                                    "        else pm.environment.set(\"token\", tokenText);",
                                    "    } catch(e) {",
                                    "        pm.environment.set(\"token\", tokenText);",
                                    "    }",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"sysadmin@mail.com\",\n    \"password\": \"123456\",\n    \"device_name\": \"postman-interop-test\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/sanctum/token",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "sanctum",
                                "token"
                            ]
                        }
                    }
                },
